<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'coordinate-portal-window-title'}"
                      MinSize="540 360"
                      SetSize="540 360">
    <BoxContainer Orientation="Vertical" Margin="8 8 8 8" SeparationOverride="8">
        <PanelContainer Name="StatusPanel" StyleClasses="Inset">
            <BoxContainer Orientation="Vertical" Margin="10 8 10 8" SeparationOverride="6">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'coordinate-portal-status-header'}" MinWidth="130" />
                    <Label Name="StatusValue" HorizontalExpand="True" />
                    <Label Name="LocalPositionLabel" HorizontalAlignment="Right" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'coordinate-portal-recharge'}" MinWidth="130" />
                    <ProgressBar Name="CooldownBar"
                                 HorizontalExpand="True"
                                 MinValue="0"
                                 MaxValue="1"
                                 SetHeight="22" />
                    <Label Name="CooldownText" MinWidth="48" Margin="8 0 0 0" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <PanelContainer Name="TargetPanel" StyleClasses="Inset" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10 10 10 10" SeparationOverride="10">
                <Label Text="{Loc 'coordinate-portal-target-header'}" HorizontalAlignment="Center" />

                <GridContainer Columns="2" HSeparationOverride="8" VSeparationOverride="8">
                    <Label Text="{Loc 'coordinate-portal-target-x'}" VerticalAlignment="Center" />
                    <SpinBox Name="TargetX" HorizontalExpand="True" MinSize="160 0" />
                    <Label Text="{Loc 'coordinate-portal-target-y'}" VerticalAlignment="Center" />
                    <SpinBox Name="TargetY" HorizontalExpand="True" MinSize="160 0" />
                </GridContainer>

                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Button Name="UseCurrentButton"
                            Text="{Loc 'coordinate-portal-current-button'}"
                            HorizontalExpand="True" />
                    <Button Name="SetTargetButton"
                            Text="{Loc 'coordinate-portal-set-button'}"
                            HorizontalExpand="True" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <Button Name="TogglePortalButton"
                Text="{Loc 'coordinate-portal-open-button'}"
                SetHeight="38" />
    </BoxContainer>
</controls:FancyWindow>
